NODE_ENV=development
PORT=4000

# Postgres (docker compose service name) — override for local non-docker runs
DATABASE_URL=postgresql://trading:trading@postgres:5432/trading_agent?schema=public

# Upstash Redis (use the rediss:// TLS URL from the Upstash console)
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# Generate strong secrets: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
BCRYPT_ROUNDS=10
CHAT_CONTEXT_LIMIT=20
