# ---------------------------------------------------------------------------
# Postgres (local container)
# ---------------------------------------------------------------------------
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading_agent

# ---------------------------------------------------------------------------
# Upstash Redis (external). Use the rediss:// TLS URL from the Upstash console.
# ---------------------------------------------------------------------------
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# ---------------------------------------------------------------------------
# Auth secrets. Generate with: openssl rand -hex 32
# JWT_ACCESS_SECRET is shared by gateway + backend.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# ---------------------------------------------------------------------------
# Gateway security
# ---------------------------------------------------------------------------
# Comma-separated allowlist: Cloudflare Pages domain + local dev server.
ALLOWED_ORIGINS=https://your-project.pages.dev,http://localhost:5173
ALLOW_MISSING_ORIGIN=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_CHAT_MAX=20

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# Named tunnel (stable): paste the token from the Zero Trust dashboard
#   (Networks -> Tunnels -> your tunnel -> install command) or `cloudflared tunnel token <name>`.
# Public hostname api.yourdomain.com -> http://gateway:8080
# For an account-less quick tunnel, leave this blank and run:
#   docker compose -f docker-compose.yml -f docker-compose.quicktunnel.yml up
# ---------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# Host port to bind the gateway for local debugging (127.0.0.1 only).
GATEWAY_PORT=8080
