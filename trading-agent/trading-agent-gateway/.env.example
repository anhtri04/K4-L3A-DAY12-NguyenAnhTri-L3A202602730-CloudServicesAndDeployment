NODE_ENV=development
PORT=8080

# Internal backend URL (docker compose service name)
BACKEND_URL=http://backend:4000

# Upstash Redis (must be the same instance as the backend)
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# Must match the backend's JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars

# Comma-separated allowlist: Cloudflare Pages domain + local dev
ALLOWED_ORIGINS=https://your-project.pages.dev,http://localhost:5173

# true = allow server-to-server/curl requests without an Origin header
ALLOW_MISSING_ORIGIN=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_CHAT_MAX=20
